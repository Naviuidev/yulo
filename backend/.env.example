# Application
APP_NAME=YULO
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/yulo/backend
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yulo_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# Uploads
UPLOAD_PATH=uploads
MAX_UPLOAD_SIZE=5242880

# Mail (Gmail SMTP — use an App Password, never commit real credentials)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME=YULO
# Owner inbox for new-order notifications (fallback: Admin Settings store_email → MAIL_FROM_ADDRESS)
OWNER_EMAIL=your-gmail@gmail.com

# PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
PHONEPE_CALLBACK_URL=http://localhost/yulo/backend/api/payments/phonepe/callback

# Cashfree (prefer Admin → Payments; env is optional fallback)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_URL=

# Shiprocket (prefer Admin → Shiprocket; env is optional fallback)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_ENABLED=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

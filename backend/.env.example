# Application
APP_NAME=YULO
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/yulo/backend
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yulo_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# Uploads
UPLOAD_PATH=uploads
MAX_UPLOAD_SIZE=5242880

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yulo.com
MAIL_FROM_NAME=YULO

# PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
PHONEPE_CALLBACK_URL=http://localhost/yulo/backend/api/payments/phonepe/callback

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

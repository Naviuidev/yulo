<IfModule mod_rewrite.c>
    RewriteEngine On
    # Production (api.yulowear.in): /api/
    # Local XAMPP fallback path was /yulo/backend/api/
    RewriteBase /api/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ ../index.php [QSA,L]
</IfModule>

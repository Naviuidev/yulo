# Copy to deploy.env and fill MilesWeb SSH details:
#   cp deploy.env.example deploy.env
#
# Find these in MilesWeb cPanel → SSH Access / FTP Accounts
# Host is often something like: server.milesweb.com  OR  your server IP

DEPLOY_HOST=YOUR_SERVER_HOST_OR_IP
DEPLOY_USER=YOUR_CPANEL_USERNAME
DEPLOY_PORT=22

# Remote folders (relative to home, or absolute paths from File Manager)
# Typical MilesWeb layout:
REMOTE_WEBSITE=~/public_html
REMOTE_ADMIN=~/admin.yulowear.in
REMOTE_API=~/api.yulowear.in
